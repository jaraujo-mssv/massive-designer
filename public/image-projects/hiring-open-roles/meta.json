{
  "id": "hiring-open-roles",
  "title": "Hiring: All open roles",
  "description": "Every open role on one card, by team (Engineering 4, Marketing 2, Sales 3), with where each one is based. Refresh from joinmassive.com/careers when roles change.",
  "group": "massive",
  "category": "hiring",
  "template": "hiring-photo",
  "series": "Open roles",
  "status": "draft",
  "tags": [
    "hiring",
    "careers",
    "roundup"
  ],
  "source": "https://www.joinmassive.com/careers/",
  "width": 1080,
  "height": 1350,
  "fields": [
    {
      "id": "photo",
      "label": "Photo",
      "type": "image",
      "default": "assets/photo.webp"
    },
    {
      "id": "headline",
      "label": "Headline",
      "type": "text",
      "default": "We’re hiring"
    },
    {
      "id": "role",
      "label": "Role (on the swipe)",
      "type": "text",
      "default": "9 open roles"
    },
    {
      "id": "details",
      "label": "Details line",
      "type": "text",
      "default": "Engineering · Marketing · Sales"
    },
    {
      "id": "team1",
      "label": "Team 1",
      "type": "text",
      "default": "Engineering"
    },
    {
      "id": "roles1",
      "label": "Team 1 roles (Role · Where; …)",
      "type": "text",
      "default": "Security Researcher (Junior) · Remote; Senior Backend Engineer · Remote; Senior Data Engineer · Remote; Support Engineer · Remote"
    },
    {
      "id": "team2",
      "label": "Team 2",
      "type": "text",
      "default": "Marketing"
    },
    {
      "id": "roles2",
      "label": "Team 2 roles (Role · Where; …)",
      "type": "text",
      "default": "Social Media Coordinator · Remote, part-time; Writer in Residence · Remote"
    },
    {
      "id": "team3",
      "label": "Team 3",
      "type": "text",
      "default": "Sales"
    },
    {
      "id": "roles3",
      "label": "Team 3 roles (Role · Where; …)",
      "type": "text",
      "default": "Account Executive · Remote, EU; Account Executive · San Francisco; GTM Representative · San Francisco"
    },
    {
      "id": "aside",
      "label": "Handwritten note",
      "type": "text",
      "default": "Your desk?"
    },
    {
      "id": "showAside",
      "label": "Handwritten note",
      "type": "toggle",
      "default": false
    },
    {
      "id": "experience",
      "label": "Experience",
      "type": "text",
      "default": "Remote-first · Unlimited vacation"
    },
    {
      "id": "cta",
      "label": "Call to action",
      "type": "text",
      "default": "See every role at joinmassive.com/careers"
    }
  ]
}

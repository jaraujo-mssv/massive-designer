# ElevenLabs: image generation for npm run content:photos, and narration for npm run video:voice
# (that one reads it from the shell only). https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ElevenLabs key with the image_video_generation permission, for npm run merch:mockups (falls back to ELEVENLABS_API_KEY)
ELEVENLABS_IMAGE_API_KEY=

# Gemini image generation for npm run content:photos --provider=google (https://aistudio.google.com/apikey)
GOOGLE_AI_API_KEY=

{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm install --no-save --no-audit --no-fund",
            "timeout": 300,
            "statusMessage": "Installing npm dependencies"
          }
        ]
      }
    ]
  }
}

# Copy to .env. Every key is optional: each one unlocks a few commands, and `npm run doctor` says which are set.
# A real environment variable wins over .env.

# ElevenLabs: narration for npm run video:voice, and image generation for npm run content:photos.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ElevenLabs key with the image_video_generation permission, for npm run merch:mockups (falls back to ELEVENLABS_API_KEY)
ELEVENLABS_IMAGE_API_KEY=

# Gemini image generation for npm run content:photos --provider=google (GEMINI_API_KEY works too)
# https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

      ],
      "hint": "Pick one of the hiring photos, or upload your own: subject on the right, an empty bright left side."
    },
    {
      "id": "headline",
      "label": "Headline",
      "type": "text",
      "default": "We hired",
      "hint": "Keep it short; a long word shrinks to stay clear of the photo."
    },
    {
      "id": "role",
      "label": "Role",
      "type": "text",
      "default": "Community Lead",
      "hint": "The role that was filled, as it was posted; on the red stroke, up to two lines, it shrinks to fit."
    },
    {
      "id": "aside",
      "label": "Handwritten note",
      "type": "text",
      "default": "Desk: taken.",
      "hint": "A short joke about the photo, like “Desk: taken.”; the arrow points into the photo."
    },
    {
      "id": "showAside",
      "label": "Show the note",
      "type": "toggle",
      "default": true,
      "hint": "Hide the note and its arrow."
    }
  ]
